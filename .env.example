# Copy this file to .env.local and fill in real values from your EmailJS account
# (emailjs.com -> free tier). .env.local is gitignored automatically (see *.local
# in .gitignore) so these values never get committed.
#
# These are read by the /api/contact serverless function (server-side only),
# NOT by the browser, so they must NOT use the VITE_ prefix.
#
# Setup steps:
# 1. Create a free account at https://www.emailjs.com
# 2. Add an Email Service (e.g. connect sajahamad285@gmail.com) -> copy its Service ID
# 3. Create an Email Template with variables matching the contact form field names:
#    {{name}} {{email}} {{projectType}} {{scope}} {{message}} -> copy its Template ID
# 4. Account -> General -> copy your Public Key
# 5. Account -> API Keys -> enable "Allow EmailJS API for non-browser applications"
#    and copy your Private Key
# 6. Paste the four values below (locally in .env.local, and in your Vercel
#    project's Environment Variables for production), restart `npm run dev`

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
