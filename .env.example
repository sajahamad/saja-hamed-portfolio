# Copy this file to .env.local and fill in real values from your EmailJS account
# (emailjs.com → free tier). .env.local is gitignored automatically (see *.local
# in .gitignore) so these values never get committed.
#
# Setup steps:
# 1. Create a free account at https://www.emailjs.com
# 2. Add an Email Service (e.g. connect marketingsaja279@gmail.com) → copy its Service ID
# 3. Create an Email Template with variables matching the contact form field names:
#    {{name}} {{email}} {{projectType}} {{scope}} {{message}} → copy its Template ID
# 4. Account → General → copy your Public Key
# 5. Paste the three values below, restart `npm run dev`

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
